# Copy to .env and edit:  cp .env.example .env

# Your domain (point an A record to the VPS IP first) -> HTTPS is automatic.
# No domain yet? use  DOMAIN=:80  and open http://<VPS-IP>/
DOMAIN=:80

# Required for a public server. Generate one with:  openssl rand -hex 24
API_KEY=

# KVM2 has 2 vCPU -> 2 worker processes (one per core)
OCR_WORKERS=2

MAX_UPLOAD_MB=25
MAX_PDF_PAGES=50
PDF_DPI=200
